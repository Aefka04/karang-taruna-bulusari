<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — {{ site.nama_organisasi }}</title>
<meta name="description" content="{{ description }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,500;0,600;1,500&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/style.css">
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
</head>
<body>

<header class="site-header">
  <div class="nav-row">
    <a class="brand" href="/">
      <svg class="brand-mark" width="38" height="38" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <circle cx="20" cy="20" r="19" fill="#1f4d3a" stroke="#c9902c" stroke-width="1.4"/>
        <path d="M20 9c-4 4-4 9 0 13 4-4 4-9 0-13z" fill="#c9902c"/>
        <path d="M20 22c-5.2 0-9.4 3.8-9.4 8.6h18.8C29.4 25.8 25.2 22 20 22z" fill="#dcebdd"/>
      </svg>
      <span class="brand-text">
        <strong>{{ site.nama_singkat }}</strong>
        <span>{{ site.nama_wilayah }}</span>
      </span>
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-controls="main-nav">Menu ☰</button>
    <nav class="main-nav" id="main-nav">
      <ul>
        <li><a href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>Beranda</a></li>
        <li><a href="/tentang/" {% if page.url == "/tentang/" %}aria-current="page"{% endif %}>Tentang Kami</a></li>
        <li><a href="/kegiatan/" {% if page.url == "/kegiatan/" %}aria-current="page"{% endif %}>Kegiatan</a></li>
        <li><a href="/galeri/" {% if page.url == "/galeri/" %}aria-current="page"{% endif %}>Galeri</a></li>
        <li><a href="/absensi-kas/" {% if page.url == "/absensi-kas/" %}aria-current="page"{% endif %}>Absensi &amp; Kas</a></li>
        <li><a href="/kontak/" {% if page.url == "/kontak/" %}aria-current="page"{% endif %}>Kontak</a></li>
      </ul>
    </nav>
  </div>
</header>

{{ content | safe }}

<footer class="site-footer">
  <div class="wrap footer-row">
    <div>
      <strong style="color:#f4efdd;">{{ site.nama_organisasi }}</strong>
      <p style="margin:6px 0 0; max-width:40ch;">Media informasi &amp; dokumentasi kegiatan kepemudaan desa.</p>
    </div>
    <nav aria-label="Tautan footer">
      <ul>
        <li><a href="/">Beranda</a></li>
        <li><a href="/tentang/">Tentang</a></li>
        <li><a href="/kegiatan/">Kegiatan</a></li>
        <li><a href="/galeri/">Galeri</a></li>
        <li><a href="/absensi-kas/">Absensi &amp; Kas</a></li>
        <li><a href="/kontak/">Kontak</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap footer-note">© {{ site.tahun_footer }} {{ site.nama_organisasi }}. Situs ini bersifat informatif dan tidak menerima pendaftaran anggota secara daring.</div>
</footer>

<script src="/assets/main.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
</body>
</html>
